  "postgresql": {
    "description": "PostgreSQL database server",
    "category": "database",
    "versions": [
      "16",
      "15",
      "14",
      "13"
    ],
    "subtasks": {
      "packages": {
        "label": "Install PostgreSQL server",
        "required": true,
        "templates": {
          "apt": {
            "name": "Install PostgreSQL {version}",
            "plugin": "apt",
            "repos": [
              {
                "name": "pgdg",
                "url": "deb [signed-by=/etc/apt/keyrings/pgdg.gpg] https://apt.postgresql.org/pub/repos/apt {codename}-pgdg main",
                "gpg_key": "https://www.postgresql.org/media/keys/ACCC4CF8.asc"
              }
            ],
            "packages": [
              "postgresql-{version}"
            ]
          },
          "dnf": {
            "name": "Install PostgreSQL {version}",
            "plugin": "dnf",
            "repos": [
              {
                "name": "pgdg",
                "baseurl": "https://download.postgresql.org/pub/repos/yum/{version}/redhat/rhel-$releasever-$basearch",
                "gpgkey": "https://download.postgresql.org/pub/repos/yum/RPM-GPG-KEY-PGDG"
              }
            ],
            "packages": [
              "postgresql{version}-server"
            ]
          }
        }
      },
      "client-tools": {
        "label": "Install client tools (psql CLI only)",
        "required": false,
        "templates": {
          "apt": {
            "name": "Install PostgreSQL Client {version}",
            "plugin": "apt",
            "repos": [
              {
                "name": "pgdg",
                "url": "deb [signed-by=/etc/apt/keyrings/pgdg.gpg] https://apt.postgresql.org/pub/repos/apt {codename}-pgdg main",
                "gpg_key": "https://www.postgresql.org/media/keys/ACCC4CF8.asc"
              }
            ],
            "packages": [
              "postgresql-client-{version}"
            ]
          },
          "dnf": {
            "name": "Install PostgreSQL Client {version}",
            "plugin": "dnf",
            "repos": [
              {
                "name": "pgdg",
                "baseurl": "https://download.postgresql.org/pub/repos/yum/{version}/redhat/rhel-$releasever-$basearch",
                "gpgkey": "https://download.postgresql.org/pub/repos/yum/RPM-GPG-KEY-PGDG"
              }
            ],
            "packages": [
              "postgresql{version}"
            ]
          }
        }
      }
    }
  },
